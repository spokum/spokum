{
  "name": "spokum-desktop",
  "version": "1.0.0",
  "description": "СпокУм — соцсеть про спокойствие и настроение",
  "homepage": "https://spokum.ru",
  "author": "SpokУм",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage rpm",
    "build:all": "electron-builder --win portable --linux AppImage rpm"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.spokum.app",
    "productName": "СпокУм",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] }
      ],
      "icon": "icon.png",
      "category": "Network",
      "maintainer": "SpokУм",
      "vendor": "SpokУм",
      "synopsis": "Соцсеть про спокойствие и настроение"
    }
  }
}
