{
  "name": "spokum-desktop",
  "version": "1.0.0",
  "description": "СпокУм — соцсеть про спокойствие и настроение",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:exe": "electron-builder --win portable"
  },
  "devDependencies": {
