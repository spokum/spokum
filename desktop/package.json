{
  "name": "spokum-desktop",
  "version": "2.1.0",
  "description": "СпокУм",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npx electron-builder --win --x64"
  },
  "build": {
    "appId": "com.spokum.app",
    "productName": "Spokum",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icon.ico"],
    "win": {
      "target": ["portable"],
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  }
}
