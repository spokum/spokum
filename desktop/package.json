{
  "name": "spokum-desktop",
  "version": "2.1.0",
  "main": "main.js",
  "build": {
    "appId": "com.spokum.app",
    "productName": "Spokum",
    "directories": { "output": "dist" },
    "files": ["main.js", "icon.png"],
    "win": {
      "target": ["portable"],
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "spokum.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
